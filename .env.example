NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave service_role (Settings -> API en Supabase). NUNCA debe llevar el
# prefijo NEXT_PUBLIC_ ni exponerse al navegador: solo se usa en Server
# Actions de administrador (crear usuarios, activar/desactivar accesos).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clave de Groq (gratis en https://console.groq.com/keys) para que UDH Bot
# converse con un modelo real. Solo se usa en el servidor (src/app/api/udh-bot).
# Si se deja vacia o sin configurar, el bot sigue funcionando con su
# respaldo de preguntas frecuentes basado en palabras clave.
GROQ_API_KEY=your-groq-api-key

# Clave de OpenRouteService (gratis hasta 2000 req/dia en
# https://openrouteservice.org/dev/#/signup) para que "Escuela más cercana"
# calcule distancia/tiempo por ruta real (carretera) en vez de línea recta.
# Solo se usa en el servidor (src/app/api/rutas). Si se deja vacía, la
# búsqueda sigue funcionando igual que hoy, en línea recta.
ORS_API_KEY=your-openrouteservice-api-key

# Fuerza el proveedor de rutas ("ors" o "linea_recta"). Opcional: por
# defecto usa "ors" si hay ORS_API_KEY configurada, si no "linea_recta".
ROUTING_PROVIDER=ors

# Clave de Anthropic (https://console.anthropic.com/) para que la
# recomendación de "Escuela más cercana" redacte su explicación en lenguaje
# natural con Claude. Solo se usa en el servidor (src/lib/recomendacion). Si
# se deja vacía, se usa una explicación por plantilla (sin IA), igualmente
# completa.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
